# ~/.config/mako/config

# ── Global Settings (Must come first) ───────────────────
default-timeout=5000
group-by=app-name
sort=-time
layer=overlay

# Layout & Styling
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7
border-radius=8
border-size=2
padding=10
margin=10
width=350
height=110

font=JetBrainsMono Nerd Font 11
icons=1
max-icon-size=48


# ── Urgency Overrides ───────────────────────────────────

# Critical notifications (e.g. low battery) never auto-dismiss
[urgency=critical]
default-timeout=0

# Low-priority notifications disappear faster
[urgency=low]
default-timeout=3000
